<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Properties>
        <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %40.40F:%4.4L - %msg%n</Property>
        <Property name="maxSize">50 MB</Property>
        <Property name="backups">10</Property>
        <Property name="applicationLog">${sys:logName:-server}</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}" />
        </Console>

        <RollingFile name="ApplicationFile" fileName="log/${applicationLog}.log"
                     filePattern="log/${applicationLog}-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="HostReceivingFile" fileName="log/hostReceiving.log"
                     filePattern="log/hostReceiving-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="HostRetrievalFile" fileName="log/hostRetrieval.log"
                     filePattern="log/hostRetrieval-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="ReplenishmentFile" fileName="log/replenishment.log"
                     filePattern="log/replenishment-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="ReservationFile" fileName="log/reservation.log"
                     filePattern="log/reservation-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="ToteTransportFile" fileName="log/toteTransport.log"
                     filePattern="log/toteTransport-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="MfsMessagesFile" fileName="log/mfsMessages.log"
                     filePattern="log/mfsMessages-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="application" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ApplicationFile" />
        </Logger>

        <Logger name="hostReceiving" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="HostReceivingFile" />
        </Logger>

        <Logger name="hostRetrieval" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="HostRetrievalFile" />
        </Logger>

        <Logger name="replenishment" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ReplenishmentFile" />
        </Logger>

        <Logger name="reservation" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ReservationFile" />
        </Logger>

        <Logger name="toteTransport" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ToteTransportFile" />
        </Logger>

        <Logger name="mfsMessages" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="MfsMessagesFile" />
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>