<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="INFO">
    <Properties>
        <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %40.40F:%4.4L - %msg%n</Property>
        <Property name="maxSize">50 MB</Property>
        <Property name="backups">10</Property>
        <Property name="applicationLog">${sys:logName:-server}</Property>
        <Property name="basePackage">ro.demo.usersbackend</Property>
        <Property name="serverPackage">${basePackage}.server</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}" />
        </Console>

        <RollingFile name="ApplicationFile" fileName="log/${applicationLog}.log"
                     filePattern="log/${applicationLog}-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="ControllerFile" fileName="log/controller.log"
                     filePattern="log/controller-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="MessagingFile" fileName="log/messaging.log"
                     filePattern="log/messaging-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="AutomaticFile" fileName="log/automatic.log"
                     filePattern="log/automatic-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="HostFile" fileName="log/host.log"
                     filePattern="log/host-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="MfsFile" fileName="log/mfs.log"
                     filePattern="log/mfs-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="PrintingFile" fileName="log/printing.log"
                     filePattern="log/printing-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="ReplenishmentFile" fileName="log/replenishment.log"
                     filePattern="log/replenishment-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="ReservationFile" fileName="log/reservation.log"
                     filePattern="log/reservation-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="TransportFile" fileName="log/transport.log"
                     filePattern="log/transport-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="ServiceFile" fileName="log/service.log"
                     filePattern="log/service-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>

        <RollingFile name="SimFile" fileName="log/sim.log"
                     filePattern="log/sim-%i.log">
            <PatternLayout pattern="${pattern}" />
            <SizeBasedTriggeringPolicy size="${maxSize}" />
            <DefaultRolloverStrategy max="${backups}" fileIndex="min" />
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="${basePackage}" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ApplicationFile" />
        </Logger>

        <Logger name="${basePackage}.controller" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ControllerFile" />
        </Logger>

        <Logger name="${basePackage}.messaging" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="MessagingFile" />
        </Logger>

        <Logger name="${serverPackage}.automatic" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="AutomaticFile" />
        </Logger>

        <Logger name="${serverPackage}.host" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="HostFile" />
        </Logger>

        <Logger name="${serverPackage}.mfs" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="MfsFile" />
        </Logger>

        <Logger name="${serverPackage}.printing" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="PrintingFile" />
        </Logger>

        <Logger name="${serverPackage}.replenishment" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ReplenishmentFile" />
        </Logger>

        <Logger name="${serverPackage}.reservation" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ReservationFile" />
        </Logger>

        <Logger name="${serverPackage}.transport" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="TransportFile" />
        </Logger>

        <Logger name="${basePackage}.service" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="ServiceFile" />
        </Logger>

        <Logger name="${basePackage}.sim" level="info" additivity="false">
            <AppenderRef ref="Console" />
            <AppenderRef ref="SimFile" />
        </Logger>

        <Root level="info">
            <AppenderRef ref="Console" />
        </Root>
    </Loggers>
</Configuration>